rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funcoes auxiliares de autenticacao e autorizacao
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email in ['admin@thr33.com', 'sac@thr33.com', 'contato@thr33.com']
      );
    }

    // Colecao principal de pedidos da THR33 ('orders')
    // Leitura permitida apenas para o cliente proprietario ou administradores
    // Criacao permitida apenas com status inicial seguro (aguardando_pagamento / pendente)
    // Atualizacao de status, pagamentos e NF-e blindada contra alteracoes no cliente (exclusivo Backend Admin SDK)
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && 
        (request.resource.data.userId == request.auth.uid) &&
        (request.resource.data.status in ['aguardando_pagamento', 'pendente']) &&
        (!('nfe' in request.resource.data) || request.resource.data.nfe.issued == false);
      allow update: if isAdmin() || (
        isAuthenticated() && 
        resource.data.userId == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'status', 
          'paidAt', 
          'nfe', 
          'nfeIssued', 
          'nfeKey', 
          'nfeUrl', 
          'pagbank', 
          'amountInCents', 
          'total'
        ])
      );
      allow delete: if isAdmin();

      // Historico de eventos PagBank com gravacao restrita exclusivamente ao backend
      match /historico_pagamento/{histId} {
        allow read: if isAuthenticated() && (get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid || isAdmin());
        allow write: if false;
      }
    }

    // Colecao de fallback de pedidos ('pedidos')
    match /pedidos/{orderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.status in ['aguardando_pagamento', 'pendente']);
      allow update: if isAdmin();
      allow delete: if isAdmin();

      match /historico_pagamento/{histId} {
        allow read: if isAuthenticated() && (get(/databases/$(database)/documents/pedidos/$(orderId)).data.userId == request.auth.uid || isAdmin());
        allow write: if false;
      }
    }

    // Catalogo de produtos: leitura publica e edicao exclusiva para admin
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Cupons de desconto: leitura publica e gerenciamento por admin
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Perfis de usuarios: leitura e escrita apenas pelo titular da conta ou admin
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Sessões de telemetria anonima e analitica
    match /analytics/{docId} {
      allow read, write: if true;
    }
  }
}
