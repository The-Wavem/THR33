rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funcoes auxiliares de autenticacao e autorizacao
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email in [
          'contato.thewavem@gmail.com',
          'thewavem@gmail.com',
          'admin@thr33.com',
          'sac@thr33.com',
          'contato@thr33.com'
        ] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true))
      );
    }

    // Colecao principal de pedidos da THR33 ('orders')
    match /orders/{orderId} {
      allow read: if (isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin())) || resource.data.userId == 'guest';
      allow create: if (isAuthenticated() && request.resource.data.userId == request.auth.uid) ||
        (request.resource.data.userId == 'guest' || !('userId' in request.resource.data) || request.resource.data.userId == null);
      allow update: if isAdmin() || (
        isAuthenticated() && 
        resource.data.userId == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'status', 
          'paidAt', 
          'nfe', 
          'nfeIssued', 
          'nfeKey', 
          'nfeUrl', 
          'pagbank', 
          'amountInCents', 
          'total'
        ])
      );
      allow delete: if isAdmin();

      // Historico de eventos PagBank com gravacao restrita exclusivamente ao backend
      match /historico_pagamento/{histId} {
        allow read: if isAuthenticated() && (get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid || isAdmin());
        allow write: if false;
      }
    }

    // Colecao de fallback de pedidos ('pedidos')
    match /pedidos/{orderId} {
      allow read: if (isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin())) || resource.data.userId == 'guest';
      allow create: if true;
      allow update: if isAdmin();
      allow delete: if isAdmin();

      match /historico_pagamento/{histId} {
        allow read: if isAuthenticated() && (get(/databases/$(database)/documents/pedidos/$(orderId)).data.userId == request.auth.uid || isAdmin());
        allow write: if false;
      }
    }

    // Catalogo de produtos: leitura publica; criacao e remocao restrita a admin;
    // atualizacao permitida para admin OU incremento de metricas de telemetria publica
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'views', 'lastViewedAt', 'addedToCart', 'lastAddedToCartAt', 
          'removedFromCart', 'lastRemovedFromCartAt', 'purchases', 'lastSoldAt'
        ])
      );
    }

    // Campanhas de marketing e UTMs
    match /campaigns/{campaignId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'cartAdds', 'purchases', 'revenue', 'lastCartAddAt', 'lastPurchaseAt'
        ])
      );
    }

    // Cupons de desconto: leitura publica e gerenciamento por admin
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Configuracoes da vitrine e da loja (Bento Grid, Carrossel Hero)
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /storefront/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Sessoes ativas do checkout (recuperacao de carrinho e telemetria)
    match /checkout_sessions/{sessionId} {
      allow read, write: if true;
    }

    // Perfis de usuarios: leitura e escrita apenas pelo titular da conta ou admin
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Sessoes de telemetria anonima e analitica
    match /analytics/{docId=**} {
      allow read, write: if true;
    }
  }
}
