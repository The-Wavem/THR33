rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Regras de acesso a imagens de produtos e vitrine da THR33
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
