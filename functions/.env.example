PAGBANK_ENV=sandbox
PAGBANK_TOKEN=seu_token_aqui
PAGBANK_WEBHOOK_TOKEN=seu_token_webhook_se_houver

# PARÂMETROS OFICIAIS DE FRETE (Origem Itaquaquecetuba - SP)
